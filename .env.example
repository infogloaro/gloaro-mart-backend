
# Signing secret for payment webhooks. Unset, every webhook is rejected.
PAYMENTS_WEBHOOK_SECRET=change-me

# Sends the admin password-change OTP and its confirmation notice, over
# Resend's HTTPS API — Render blocks outbound SMTP, so a Gmail transport
# cannot reach its port from a deployed instance.
#
# MAIL_FROM defaults to Resend's shared onboarding@resend.dev, which needs
# no DNS setup but only delivers to the Resend account's own address. Set
# it to an address on a verified domain to mail anyone else.
RESEND_API_KEY=
MAIL_FROM=

# Texts the phone-login OTP through MSG91's Send OTP API. Leave
# SMS_PROVIDER empty to print OTPs to the console instead (development only;
# production then refuses phone sign-in with a clear message).
#   MSG91_AUTH_KEY        MSG91 dashboard -> Authkey
#   MSG91_OTP_TEMPLATE_ID an approved (DLT) OTP template containing ##OTP##;
#                         leave empty before DLT approval to let MSG91 use its
#                         own unbranded default OTP template (if it allows it)
#   MSG91_SENDER_ID       optional 6-letter sender id if the template needs it
#
# Before DLT approval, use MSG91's OTP Widget instead (MSG91 makes, sends
# and checks the code with its own unbranded template). When both widget
# values are set they take over from the Send OTP API above:
#   MSG91_WIDGET_ID       OTP -> Widgets -> widget id
#   MSG91_WIDGET_TOKEN    OTP -> Tokens -> token for that widget
#   MSG91_OTP_LENGTH      digits the widget sends (default 4); the app sizes
#                         its code field from this
SMS_PROVIDER=msg91
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# Encrypts credentials saved in Settings -> Platform Registry (AES-256-GCM).
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: changing or losing it makes stored credentials unreadable.
PLATFORM_SECRETS_KEY=
